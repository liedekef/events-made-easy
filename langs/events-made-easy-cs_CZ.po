msgid "Check this option if you want to allow image upload in the frontend wysiwyg editor for the event notes."
msgstr "Zaškrtněte tuto možnost, pokud chcete povolit nahrávání obrázků ve wysiwyg editoru na frontendu pro poznámky k události."

#: includes/eme-options.php:3408
msgid "Allow image upload?"
msgstr "Povolit nahrávání obrázků?"

#: includes/eme-options.php:3407
msgid "Check this option if you want to use a frontend wysiwyg editor for the event notes."
msgstr "Zaškrtněte tuto možnost, pokud chcete pro poznámky k události použít wysiwyg editor na frontendu."

#: includes/eme-options.php:3407
msgid "Use wysiwyg?"
msgstr "Použít wysiwyg?"

#. translators: %s is the default capability name
#: includes/eme-options.php:3402
msgid "Permission needed to submit a new event when guest submit is not allowed. Default: %s"
msgstr "Oprávnění potřebné pro odeslání nové události, pokud odesílání hosty není povoleno. Výchozí: %s"

