msgstr "Formát řetězce data použitého při použití showperiod=monthly jako možnosti shortcode &#91;eme_events], také použitý pro měsíční stránkování. Použijte formát kompatibilní s php funkcí date()."

#: includes/eme-options.php:1845
msgid "Monthly period date format"
msgstr "Formát datumu měsíční periody"

#: includes/eme-options.php:1844
msgid "<br> Use <code>#_ATTENDEES</code> to get a list of the names attending the event."
msgstr "<br> Pomocí <code>#_ATTENDEES</code> získáte seznam jmen účastníků události."

#: includes/eme-options.php:1844
msgid "<br> Use <code>#_CATEGORIES</code> to insert a comma-separated list of categories an event is in."
msgstr "<br> Pomocí <code>#_CATEGORIES</code> vložíte čárkami oddělený seznam kategorií, ve kterých se událost nachází."

#: includes/eme-options.php:1844
msgid "<br> Use <code>#_DIRECTIONS</code> to insert a form so people can ask directions to the event."
msgstr "<br> Pomocí <code>#_DIRECTIONS</code> vložíte formulář, aby si lidé mohli vyžádat navigaci k události."

#: includes/eme-options.php:1844
msgid "<br>Use <code>#_ADDBOOKINGFORM_IF_NOT_REGISTERED</code> to insert the booking form only if the user has not registered yet. Similar use <code>#_REMOVEBOOKINGFORM_IF_REGISTERED</code> to insert the booking removal form only if the user has already registered before. These two codes only work for WP users."
msgstr "<br>Pomocí <code>#_ADDBOOKINGFORM_IF_NOT_REGISTERED</code> vložíte rezervační formulář pouze pokud se uživatel ještě nezaregistroval. Podobně pomocí <code>#_REMOVEBOOKINGFORM_IF_REGISTERED</code> vložíte formulář pro odstranění rezervace pouze pokud se uživatel již dříve zaregistroval. Tyto dva kódy fungují pouze pro uživatele WP."

#: includes/eme-options.php:1844
msgid "The format of a single event page.<br>Follow the previous formatting instructions. <br>Use <code>#_MAP</code> to insert a map.<br>Use <code>#_CONTACTNAME</code>, <code>#_CONTACTEMAIL</code>, <code>#_CONTACTPHONE</code> to insert respectively the name, email address and phone number of the designated contact person. <br>Use <code>#_ADDBOOKINGFORM</code> to insert a form to allow the user to respond to your events booking one or more seats (RSVP).<br> Use <code>#_REMOVEBOOKINGFORM</code> to insert a form where users, inserting their name and email address, can remove their bookings."
msgstr "Formát stránky jednotlivé události.<br>Postupujte podle předchozích pokynů k formátování. <br>Pomocí <code>#_MAP</code> vložíte mapu.<br>Pomocí <code>#_CONTACTNAME</code>, <code>#_CONTACTEMAIL</code>, <code>#_CONTACTPHONE</code> vložíte jméno, e-mailovou adresu a telefonní číslo určené kontaktní osoby. <br>Pomocí <code>#_ADDBOOKINGFORM</code> vložíte formulář umožňující uživateli odpovědět na vaše události rezervací jednoho nebo více míst (RSVP).<br> Pomocí <code>#_REMOVEBOOKINGFORM</code> vložíte formulář, kde uživatelé zadáním svého jména a e-mailové adresy mohou odstranit své rezervace."

